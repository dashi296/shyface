FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    "insightface>=0.7" \
    "opencv-python-headless>=4.8" \
    "scipy>=1.11" \
    "Pillow>=10.0" \
    "numpy>=1.24" \
    "onnxruntime>=1.16"

ENV INSIGHTFACE_HOME=/cache
